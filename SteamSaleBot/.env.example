# Скопируйте этот файл в .env (в той же папке) и заполните реальными значениями.
# .env НЕ должен попадать в git — он уже в .gitignore.

# Токен бота из @BotFather. Возьми из старого проекта Technical/auth_data.py и СРАЗУ
# сделай /revoke + новый токен там же в @BotFather, раз старый лежал в открытом виде в коде.
BOT_TOKEN=

# Твой числовой Telegram ID (админ, куда падают фидбеки) — как admin_id в старом проекте.
# Это же значение открывает /admin_stats, /admin_premium, /admin_broadcast и т.д. —
# см. README.md "Админ-панель". Держи в секрете, это по сути пароль от админки.
ADMIN_CHAT_ID=

# Строка подключения к PostgreSQL в формате SQLAlchemy + asyncpg:
# postgresql+asyncpg://ИМЯ_ПОЛЬЗОВАТЕЛЯ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БД
# Если поднимаешь Postgres через docker-compose.yml из этого проекта — см. инструкцию в README.md,
# там же и подставится хост/имя базы, поменять нужно только пароль.
DATABASE_URL=postgresql+asyncpg://steam_bot:change_me@localhost:5432/steam_sale_bot
# Для docker-compose пароль задаётся отдельно в окружении запуска:
# POSTGRES_PASSWORD=change_me

# Опционально: redis://localhost:6379/0 — если не задать, FSM-состояния хранятся в памяти
# процесса бота и теряются при перезапуске. Для локальной разработки можно оставить пустым.
REDIS_URL=

# ОБЯЗАТЕЛЬНО для добавления игр по названию/ссылке/ID (app/services/steam_catalog.py).
# Старый бесплатный список игр без ключа (ISteamApps/GetAppList/v2) Valve отключил —
# теперь используется IStoreService/GetAppList/v1, которому нужен ключ.
# Получить бесплатно за 30 секунд: залогинься на https://steamcommunity.com/dev/apikey,
# в поле "Domain Name" можно вписать что угодно (например localhost), скопируй выданный ключ сюда.
STEAM_API_KEY=

# ОБЯЗАТЕЛЬНО, чтобы /import_wishlist мог запоминать твой Steam-профиль для повторного
# импорта — steam_id64 хранится в БД зашифрованным (app/services/crypto.py), это ключ
# шифрования. Без него сама функция импорта всё равно работает, просто каждый раз будет
# спрашивать профиль заново. Сгенерировать один раз:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храни этот ключ так же бережно, как пароль от БД — потеря ключа = потеря доступа к уже
# сохранённым steam_id64 (не ко всему боту, только к этому одному полю).
DATA_ENCRYPTION_KEY=

# Необязательно — есть значения по умолчанию в app/config.py, менять не обязательно:
# SALE_POLL_INTERVAL_MINUTES=5      как часто проверять скидки для обычных чатов
# PREMIUM_POLL_INTERVAL_MINUTES=1   как часто проверять скидки для Premium-чатов
# MARKET_POLL_INTERVAL_MINUTES=5    как часто проверять алерты по предметам Market (Premium)
# PREMIUM_PRICE_STARS=99            цена подписки в Telegram Stars
# PREMIUM_DAYS=30                   срок подписки в днях
# FREE_GAME_LIMIT=15                лимит игр в списке на бесплатном тарифе (Premium — без лимита)
# STEAM_PRICING_RATE_LIMIT_PER_MINUTE=30   потолок скорости запросов к appdetails
# STEAM_MARKET_RATE_LIMIT_PER_MINUTE=15    потолок скорости запросов к Community Market
# THROTTLE_INTERVAL_SECONDS=0.7            мин. интервал между сообщениями от одного чата

# Опционально: DSN проекта на sentry.io (или self-hosted) для мониторинга ошибок.
# Без него бот работает как раньше, просто логи остаются только в консоли/файле.
SENTRY_DSN=

# Публичный HTTPS-адрес Mini App для кнопки /app в Telegram.
# Пример: https://steam.example.com
# Для локального просмотра в браузере можно оставить пустым и открыть http://127.0.0.1:8787 вручную.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8787
BOT_USERNAME=SteamSaleBot
PRIVACY_URL=
TERMS_URL=
SUPPORT_URL=

# Секреты legacy-админки. В production endpoint отключён; оставляйте пустыми,
# если отдельно не запускаете локальную demo-панель.
ADMIN_CODE=
ADMIN_SECRET=

# Необязательно — рост/вовлечение (см. README.md):
# TRIAL_DAYS=3                       пробный Premium, один раз на чат — /trial
# REFERRAL_REWARD_DAYS=7             награда пригласившему за первого активного реферала
# DIGEST_INTERVAL_HOURS=24           как часто слать дайджест топ-скидок опт-ин чатам
# SEASONAL_ALERT_THRESHOLD=0.3       доля отслеживаемых игр со скидкой -> баннер "началась распродажа"
# Mini App security
WEBAPP_MODE=demo
WEBAPP_AUTH_REQUIRED=0
WEBAPP_AUTH_MAX_AGE=3600
WEBAPP_RATE_LIMIT_PER_MINUTE=120
# In production set WEBAPP_MODE=production and use the same BOT_TOKEN as the bot.
